@@ -0,0 +1,82 @@
+"use client";
+
+import { AnimatePresence, motion } from "framer-motion";
+import { AnimatedNumber } from "./AnimatedNumber";
+
+type LeaderboardPlayer = {
+  id: string;
+  nickname: string;
+  score: number;
+};
+
+type LeaderboardProps = {
+  players: LeaderboardPlayer[];
+  highlightId?: string;
+  limit?: number;
+  /** Décalage du rang affiché (ex. 3 pour afficher à partir de la 4e place). */
+  rankOffset?: number;
+};
+
+export function rankPlayers<T extends LeaderboardPlayer>(players: T[]): T[] {
+  return [...players].sort(
+    (a, b) => b.score - a.score || a.nickname.localeCompare(b.nickname),
+  );
+}
+
+const MEDALS = ["🥇", "🥈", "🥉"];
+
+export function Leaderboard({
+  players,
+  highlightId,
+  limit,
+  rankOffset = 0,
+}: LeaderboardProps) {
+  const sorted = rankPlayers(players);
+  const visible = limit ? sorted.slice(0, limit) : sorted;
+
+  return (
+    <ul className="space-y-2">
+      <AnimatePresence initial={false}>
+        {visible.map((player, index) => {
+          const isMe = player.id === highlightId;
+
+          return (
+            <motion.li
+              key={player.id}
+              layout
+              initial={{ opacity: 0, x: -24 }}
+              animate={{ opacity: 1, x: 0 }}
+              exit={{ opacity: 0, x: 24 }}
+              transition={{
+                layout: { type: "spring", stiffness: 420, damping: 32 },
+                opacity: { duration: 0.2 },
+              }}
+              className={`flex items-center gap-3 rounded-2xl border p-3 ${
+                isMe
+                  ? "border-[#fde047]/60 bg-[#fde047]/10"
+                  : "border-white/10 bg-white/5"
+              }`}
+            >
+              <span className="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-[#7c3aed]/25 font-black text-[#c4b5fd]">
+                {MEDALS[index + rankOffset] ?? index + rankOffset + 1}
+              </span>
+
+              <span className="min-w-0 flex-1 truncate font-semibold">
+                {player.nickname}
+                {isMe && (
+                  <span className="ml-2 text-xs font-bold text-[#fde047]">
+                    toi
+                  </span>
+                )}
+              </span>
+
+              <span className="font-black text-[#fde047]">
+                <AnimatedNumber value={player.score} />
+              </span>
+            </motion.li>
+          );
+        })}
+      </AnimatePresence>
+    </ul>
+  );
+}
diff --git a/components/game/Podium.tsx b/components/game/Podium.tsx
new file mode 100644
index 0000000..bc8d4d7
--- /dev/null
+++ b/components/game/Podium.tsx
@@ -0,0 +1,70 @@
+"use client";
+
+import { motion } from "framer-motion";
+import { Trophy } from "lucide-react";
+import { AnimatedNumber } from "./AnimatedNumber";
+import { rankPlayers } from "./Leaderboard";
+
+type PodiumPlayer = {
+  id: string;
+  nickname: string;
+  score: number;
+};
+
+// Ordre d'affichage : 2e, 1er, 3e. Le 1er est au centre et le plus haut.
+const SLOTS = [
+  { rank: 1, height: "h-28", color: "#c0c8d8", delay: 0.6 },
+  { rank: 0, height: "h-40", color: "#fde047", delay: 1.2 },
+  { rank: 2, height: "h-20", color: "#e0955a", delay: 0.0 },
+];
+
+export function Podium({ players }: { players: PodiumPlayer[] }) {
+  const sorted = rankPlayers(players);
+
+  return (
+    <div className="mx-auto flex max-w-md items-end justify-center gap-3">
+      {SLOTS.map(({ rank, height, color, delay }) => {
+        const player = sorted[rank];
+
+        if (!player) return <div key={rank} className="w-1/3" />;
+
+        return (
+          <div key={rank} className="flex w-1/3 flex-col items-center">
+            <motion.div
+              initial={{ opacity: 0, y: -30 }}
+              animate={{ opacity: 1, y: 0 }}
+              transition={{ delay: delay + 0.5, type: "spring", stiffness: 300, damping: 16 }}
+              className="mb-2 text-center"
+            >
+              {rank === 0 && (
+                <motion.div
+                  animate={{ rotate: [-8, 8, -8] }}
+                  transition={{ duration: 2, repeat: Infinity, ease: "easeInOut" }}
+                  className="mb-1 flex justify-center text-[#fde047]"
+                >
+                  <Trophy size={30} />
+                </motion.div>
+              )}
+              <p className="max-w-full truncate text-sm font-bold">
+                {player.nickname}
+              </p>
+              <p className="text-sm font-black" style={{ color }}>
+                <AnimatedNumber value={player.score} />
+              </p>
+            </motion.div>
+
+            <motion.div
+              initial={{ scaleY: 0 }}
+              animate={{ scaleY: 1 }}
+              transition={{ delay, duration: 0.7, ease: [0.22, 1, 0.36, 1] }}
+              style={{ originY: 1, backgroundColor: color }}
+              className={`flex w-full items-start justify-center rounded-t-2xl pt-2 text-2xl font-black text-[#130b2b] ${height}`}
+            >
+              {rank + 1}
+            </motion.div>
+          </div>
+        );
+      })}
+    </div>
+  );
+}
diff --git a/components/game/ScoreBurst.tsx b/components/game/ScoreBurst.tsx
new file mode 100644
index 0000000..3e78b59
--- /dev/null
+++ b/components/game/ScoreBurst.tsx
@@ -0,0 +1,78 @@
+"use client";
+
+import { motion } from "framer-motion";
+import { Zap } from "lucide-react";
+
+type ScoreBurstProps = {
+  total: number;
+  bonus: number;
+  label?: string;
+};
+
+const COLORS = ["#fde047", "#2dd4bf", "#fb7185", "#c4b5fd", "#ffffff"];
+const PARTICLES = 20;
+
+export function ScoreBurst({
+  total,
+  bonus,
+  label = "Bonne réponse !",
+}: ScoreBurstProps) {
+  return (
+    <motion.div
+      initial={{ opacity: 0, scale: 0.4, y: 20 }}
+      animate={{ opacity: 1, scale: 1, y: 0 }}
+      transition={{ type: "spring", stiffness: 380, damping: 18 }}
+      className="relative mt-6 overflow-visible rounded-2xl border border-[#fde047]/30 bg-[#fde047]/10 p-5 text-center"
+    >
+      {/* Confettis : trajectoires déterministes pour rester pures au rendu. */}
+      <div className="pointer-events-none absolute left-1/2 top-1/2" aria-hidden>
+        {Array.from({ length: PARTICLES }, (_, i) => {
+          const angle = (i / PARTICLES) * Math.PI * 2;
+          const distance = 90 + (i % 4) * 22;
+
+          return (
+            <motion.span
+              key={i}
+              className="absolute block h-2 w-2 rounded-sm"
+              style={{ backgroundColor: COLORS[i % COLORS.length] }}
+              initial={{ x: 0, y: 0, opacity: 1, scale: 1, rotate: 0 }}
+              animate={{
+                x: Math.cos(angle) * distance,
+                y: Math.sin(angle) * distance + 24,
+                opacity: 0,
+                scale: 0.4,
+                rotate: 180 + i * 25,
+              }}
+              transition={{ duration: 1.1, ease: "easeOut" }}
+            />
+          );
+        })}
+      </div>
+
+      <motion.p
+        className="text-5xl font-black text-[#fde047]"
+        initial={{ scale: 0.6 }}
+        animate={{ scale: [0.6, 1.25, 1] }}
+        transition={{ duration: 0.5 }}
+      >
+        +{total}
+      </motion.p>
+
+      <p className="mt-1 text-sm font-semibold text-white/70">
+        {label}
+      </p>
+
+      {bonus > 0 && (
+        <motion.p
+          initial={{ opacity: 0, y: 8 }}
+          animate={{ opacity: 1, y: 0 }}
+          transition={{ delay: 0.35 }}
+          className="mt-2 inline-flex items-center gap-1.5 rounded-full bg-[#2dd4bf]/15 px-3 py-1 text-sm font-bold text-[#2dd4bf]"
+        >
+          <Zap size={14} />
+          dont +{bonus} de bonus de rapidité
+        </motion.p>
+      )}
+    </motion.div>
+  );
+}
